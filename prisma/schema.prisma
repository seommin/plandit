generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator adapterClient {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CalendarRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CalendarType {
  PERSONAL
  SHARED
  SUBSCRIBED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum EventVisibility {
  PRIVATE
  CALENDAR
  PUBLIC_LINK
}

enum AttendanceStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum ShareChannel {
  LINK
  KAKAO
  NAVER
  EMAIL
}

enum CalendarProvider {
  GOOGLE
  APPLE
  OUTLOOK
}

enum WidgetSize {
  SMALL
  MEDIUM
  LARGE
  LOCK_SCREEN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  timezone      String    @default("Asia/Seoul")
  locale        String    @default("ko-KR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  calendars     CalendarMember[]
  eventsCreated Event[]          @relation("EventCreator")
  attendees     EventAttendee[]
  invitesSent   CalendarInvite[] @relation("InviteSender")
  eventSharesCreated EventShare[] @relation("EventShareCreator")
  widgets       WidgetPreference[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Calendar {
  id          String   @id @default(cuid())
  name        String
  type        CalendarType @default(PERSONAL)
  color       String   @default("#2F6BFF")
  description String?
  timezone    String   @default("Asia/Seoul")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      CalendarMember[]
  events       Event[]
  invites      CalendarInvite[]
  integrations CalendarIntegration[]
  widgets      WidgetPreference[]
}

model CalendarMember {
  id         String       @id @default(cuid())
  calendarId String
  userId     String
  role       CalendarRole @default(VIEWER)
  joinedAt   DateTime     @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
  @@index([userId])
}

model CalendarInvite {
  id         String       @id @default(cuid())
  calendarId String
  email      String
  role       CalendarRole @default(VIEWER)
  token      String       @unique
  invitedBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sender   User     @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([calendarId])
}

model Event {
  id          String      @id @default(cuid())
  calendarId  String
  createdById String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean     @default(false)
  status      EventStatus @default(CONFIRMED)
  visibility  EventVisibility @default(CALENDAR)
  color       String?
  recurrence  Json?
  externalId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  calendar  Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator   User            @relation("EventCreator", fields: [createdById], references: [id])
  attendees EventAttendee[]
  shares    EventShare[]

  @@index([calendarId, startsAt])
  @@index([createdById])
  @@index([visibility])
  @@index([externalId])
}

model EventShare {
  id                 String       @id @default(cuid())
  eventId            String
  slug               String       @unique
  createdById        String
  channel            ShareChannel @default(LINK)
  includeDescription Boolean      @default(true)
  includeLocation    Boolean      @default(true)
  allowGuestRsvp     Boolean      @default(false)
  viewCount          Int          @default(0)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User  @relation("EventShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdById])
  @@index([channel])
}

model EventAttendee {
  id        String           @id @default(cuid())
  eventId   String
  userId    String?
  email     String
  name      String?
  status    AttendanceStatus @default(NEEDS_ACTION)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([userId])
}

model CalendarIntegration {
  id                String           @id @default(cuid())
  calendarId        String
  provider          CalendarProvider
  externalCalendarId String
  syncToken         String?
  lastSyncedAt      DateTime?
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([provider, externalCalendarId])
  @@index([calendarId])
}

model WidgetPreference {
  id          String     @id @default(cuid())
  userId      String
  calendarId  String?
  size        WidgetSize @default(MEDIUM)
  title       String     @default("Today")
  showWeather Boolean    @default(false)
  showTasks   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar Calendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  @@index([userId])
}
