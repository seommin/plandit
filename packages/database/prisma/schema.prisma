generator adapterClient {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum CalendarRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CalendarType {
  PERSONAL
  SHARED
  SUBSCRIBED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum EventVisibility {
  PRIVATE
  CALENDAR
  PUBLIC_LINK
}

enum AttendanceStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum ShareChannel {
  LINK
  KAKAO
  NAVER
  EMAIL
}

enum CalendarProvider {
  GOOGLE
  APPLE
  OUTLOOK
}

enum WidgetSize {
  SMALL
  MEDIUM
  LARGE
  LOCK_SCREEN
}

enum PushProvider {
  NOOP
  WEB_PUSH
  EXPO
  FCM
  APNS
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  timezone      String    @default("Asia/Seoul")
  locale        String    @default("ko-KR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  calendars     CalendarMember[]
  eventsCreated Event[]          @relation("EventCreator")
  attendees     EventAttendee[]
  invitesSent   CalendarInvite[] @relation("InviteSender")
  eventSharesCreated EventShare[] @relation("EventShareCreator")
  eventFavorites EventFavorite[]
  widgets       WidgetPreference[]
  pushSubscriptions PushSubscription[]
  pushDeliveries PushNotificationDelivery[]
  workspaceMemberships WorkspaceMember[]
  personalWorkspace Workspace? @relation("PersonalWorkspace")
  ledgerEntries  CreditLedger[] @relation("LedgerCreatedBy")
  auditLogs      AuditLog[]     @relation("AuditActor")
  paymentsRequested Payment[] @relation("PaymentRequestedBy")
  /// SMS/AlimTalk reminder number, digits only (01000000001). Seeds use 010-0000-xxxx only.
  phone          String?
  remindersCreated EventReminder[]
  reminderDeliveries ReminderDelivery[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Calendar {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        CalendarType @default(PERSONAL)
  color       String   @default("#2F6BFF")
  description String?
  timezone    String   @default("Asia/Seoul")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members      CalendarMember[]
  events       Event[]
  invites      CalendarInvite[]
  integrations CalendarIntegration[]
  widgets      WidgetPreference[]

  @@index([workspaceId])
}

model Workspace {
  id              String        @id @default(cuid())
  name            String
  type            WorkspaceType @default(TEAM)
  /// Set only for PERSONAL workspaces. The unique index makes "one personal workspace per user" a DB guarantee.
  personalOwnerId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  personalOwner User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  calendars     Calendar[]
  creditAccount CreditAccount?
  payments      Payment[]
  reminderDeliveries ReminderDelivery[]
  auditLogs     AuditLog[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// One per workspace. `balance` is a cache derived from CreditLedger; only LedgerService.append() changes it.
model CreditAccount {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  balance     BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ledger    CreditLedger[]
  payments  Payment[]
}

enum LedgerType {
  CHARGE
  DEBIT
  REFUND
  ADJUST
}

enum LedgerRefType {
  PAYMENT
  REMINDER_DELIVERY
  AI_USAGE
  MANUAL
}

/// Append-only. UPDATE/DELETE are rejected by a DB trigger; corrections are new ADJUST rows.
model CreditLedger {
  id             BigInt        @id @default(autoincrement())
  accountId      String
  type           LedgerType
  /// Signed: CHARGE/REFUND > 0, DEBIT < 0, ADJUST either way.
  amount         BigInt
  balanceAfter   BigInt
  refType        LedgerRefType
  refId          String
  idempotencyKey String        @unique
  memo           String?
  createdById    String?
  createdAt      DateTime      @default(now())

  account   CreditAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payment   Payment?
  deliveryDebit  ReminderDelivery? @relation("DeliveryDebit")
  deliveryRefund ReminderDelivery? @relation("DeliveryRefund")

  @@index([accountId, id(sort: Desc)])
  @@index([refType, refId])
}

enum PaymentProvider {
  MOCK_PG
}

enum PaymentStatus {
  RESERVE
  APPROVED
  FAILED
  CANCELED
  UNKNOWN
}

/// A credit top-up. Saved as RESERVE *before* the PG is called, so a lost response never leaves an untracked charge.
/// Credits are granted only by the PG webhook (or the re-query job), never by the browser redirect.
model Payment {
  id             String          @id @default(cuid())
  workspaceId    String
  accountId      String
  /// Our trade number sent to the PG: P{yyMMdd}-{seq}, seq from the payment_trade_seq sequence.
  tradeId        String          @unique
  provider       PaymentProvider
  /// KRW charged
  amount         Int
  /// Credits granted on approval
  credits        BigInt
  status         PaymentStatus   @default(RESERVE)
  providerTxId   String?         @unique
  paymentPageUrl String?
  method         String?
  failureCode    String?
  failureMessage String?
  requestedById  String
  /// = when the RESERVE row was written
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  approvedAt     DateTime?
  failedAt       DateTime?
  canceledAt     DateTime?
  /// The CHARGE ledger row written on approval
  ledgerId       BigInt?         @unique

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account     CreditAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requestedBy User           @relation("PaymentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  ledger      CreditLedger?  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  events      PaymentEvent[]

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

/// Every PG webhook we accepted (signature valid). eventId is the dedupe key for repeated deliveries.
model PaymentEvent {
  id         BigInt   @id @default(autoincrement())
  paymentId  String?
  eventId    String   @unique
  eventType  String
  payload    Json
  /// What processing did: APPLIED, ALREADY_APPLIED, UNKNOWN_PAYMENT, AMOUNT_MISMATCH, CONFLICT_STATE, UNHANDLED
  result     String
  receivedAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

model CalendarMember {
  id         String       @id @default(cuid())
  calendarId String
  userId     String
  role       CalendarRole @default(VIEWER)
  joinedAt   DateTime     @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
  @@index([userId])
}

model CalendarInvite {
  id         String       @id @default(cuid())
  calendarId String
  email      String
  role       CalendarRole @default(VIEWER)
  token      String       @unique
  invitedBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sender   User     @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([calendarId])
}

model Event {
  id          String      @id @default(cuid())
  calendarId  String
  createdById String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean     @default(false)
  status      EventStatus @default(CONFIRMED)
  visibility  EventVisibility @default(CALENDAR)
  color       String?
  recurrence  Json?
  externalId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  calendar  Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator   User            @relation("EventCreator", fields: [createdById], references: [id])
  attendees EventAttendee[]
  shares    EventShare[]
  favorites EventFavorite[]
  reminders EventReminder[]

  @@index([calendarId, startsAt])
  @@index([createdById])
  @@index([visibility])
  @@index([externalId])
}

model EventShare {
  id                 String       @id @default(cuid())
  eventId            String
  slug               String       @unique
  createdById        String
  channel            ShareChannel @default(LINK)
  includeDescription Boolean      @default(true)
  includeLocation    Boolean      @default(true)
  allowGuestRsvp     Boolean      @default(false)
  viewCount          Int          @default(0)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User  @relation("EventShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdById])
  @@index([channel])
}

model EventFavorite {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model EventAttendee {
  id        String           @id @default(cuid())
  eventId   String
  userId    String?
  email     String
  name      String?
  status    AttendanceStatus @default(NEEDS_ACTION)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([userId])
}

model CalendarIntegration {
  id                String           @id @default(cuid())
  calendarId        String
  provider          CalendarProvider
  externalCalendarId String
  syncToken         String?
  lastSyncedAt      DateTime?
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([provider, externalCalendarId])
  @@index([calendarId])
}

model WidgetPreference {
  id          String     @id @default(cuid())
  userId      String
  calendarId  String?
  size        WidgetSize @default(MEDIUM)
  title       String     @default("Today")
  showWeather Boolean    @default(false)
  showTasks   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar Calendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PushSubscription {
  id         String       @id @default(cuid())
  userId     String
  provider   PushProvider @default(NOOP)
  endpoint   String
  externalId String?
  deviceName String?
  userAgent  String?
  platform   String?
  enabled    Boolean      @default(true)
  metadata   Json?
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushNotificationDelivery[]

  @@unique([provider, endpoint])
  @@index([userId])
  @@index([provider, enabled])
}

model PushNotificationDelivery {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String?
  provider       PushProvider
  title          String
  body           String?
  url            String?
  status         String       @default("PENDING")
  providerMessageId String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([provider, status])
}

enum ReminderChannel {
  PUSH
  SMS
  ALIMTALK
}

enum ReminderAudience {
  /// the event's creator only
  CREATOR
  /// creator + attendees who are Plandit users
  ATTENDEES
}

model EventReminder {
  id            String           @id @default(cuid())
  eventId       String
  /// fire time = event start (all-day: 09:00 of the start date in the calendar timezone) - minutesBefore
  minutesBefore Int
  channel       ReminderChannel
  audience      ReminderAudience @default(CREATOR)
  createdById   String
  createdAt     DateTime         @default(now())

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy  User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@unique([eventId, minutesBefore, channel])
}

enum DeliveryStatus {
  /// written before any external call
  QUEUED
  /// accepted by the carrier (or push provider), result pending
  SENT
  DELIVERED
  FAILED
  /// not sent (no phone, not enough credits) — nothing charged
  SKIPPED
}

/// One reminder to one person at one fire time. Paid channels debit credits before sending and refund on failure.
/// Kept when the event/reminder is deleted (reminderId → null) because it may reference ledger rows.
model ReminderDelivery {
  id             String          @id @default(cuid())
  reminderId     String?
  userId         String
  /// workspace charged (owner of the event's calendar at fire time)
  workspaceId    String
  channel        ReminderChannel
  fireAt         DateTime
  status         DeliveryStatus  @default(QUEUED)
  toPhone        String?
  credits        Int             @default(0)
  relayMsgId     String?         @unique
  failCode       String?
  /// what happened instead when a paid channel was skipped (e.g. PUSH_SENT)
  fallback       String?
  debitLedgerId  BigInt?         @unique
  refundLedgerId BigInt?         @unique
  queuedAt       DateTime        @default(now())
  sentAt         DateTime?
  resultAt       DateTime?

  reminder     EventReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  debitLedger  CreditLedger?  @relation("DeliveryDebit", fields: [debitLedgerId], references: [id], onDelete: Restrict)
  refundLedger CreditLedger?  @relation("DeliveryRefund", fields: [refundLedgerId], references: [id], onDelete: Restrict)
  relayEvents  RelayEvent[]

  @@unique([reminderId, userId, fireAt])
  @@index([status, sentAt])
  @@index([workspaceId, queuedAt])
}

/// Carrier result webhooks we accepted (signature valid). eventId dedupes repeated deliveries.
model RelayEvent {
  id         BigInt   @id @default(autoincrement())
  deliveryId String?
  eventId    String   @unique
  status     String
  payload    Json
  /// APPLIED, ALREADY_APPLIED, UNKNOWN_DELIVERY
  result     String
  receivedAt DateTime @default(now())

  delivery ReminderDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
}

/// Who changed what, when, from which request. Append-only (DB trigger), written in the same transaction as the change.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  workspaceId String?
  /// null = system (webhook, scheduled job)
  actorId     String?
  /// e.g. workspace.member_role_changed, payment.approved, credit.adjusted
  action      String
  targetType  String
  targetId    String
  /// before/after or context of the change
  payload     Json?
  traceId     String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, id(sort: Desc)])
  @@index([action])
}
