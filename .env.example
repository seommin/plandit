# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
API_INTERNAL_URL=http://localhost:4000
API_INTERNAL_SECRET=replace-with-a-long-random-internal-secret
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://plandit:plandit@localhost:5432/plandit
DIRECT_URL=postgresql://plandit:plandit@localhost:5432/plandit

# Redis (BullMQ queues, health check)
REDIS_URL=redis://localhost:6379

# API log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Prometheus: bearer token for the api's /metrics (empty = no token; block /metrics at the proxy anyway),
# and the port where the worker process serves its own /metrics (empty = off)
METRICS_TOKEN=
WORKER_METRICS_PORT=9464

# Public API (/v1): requests per minute allowed for each API key (over → 429 + Retry-After)
API_KEY_RATE_LIMIT_PER_MIN=60

# Comma-separated emails of platform operators (can make manual credit adjustments).
# Not the same as workspace OWNER/ADMIN.
PLATFORM_ADMIN_EMAILS=

# Payments (api side). PAYMENT_PROVIDER picks the PaymentGateway implementation: mock
PAYMENT_PROVIDER=mock
# Where the api calls the mock PG
MOCK_PG_BASE_URL=http://localhost:4100/pg
# Optional: webhook URL the api asks the PG to call (overrides MOCK_PG_WEBHOOK_URL below). Leave empty locally.
PAYMENT_WEBHOOK_URL=

# Payment re-query job (worker): how often it runs, how old a RESERVE/UNKNOWN payment must be before it's
# re-queried (gives the webhook time to arrive), and when an unpaid payment is given up (ms)
RECONCILE_EVERY_MS=60000
RECONCILE_MIN_AGE_MS=300000
PAYMENT_EXPIRE_AFTER_MS=86400000

# Reminders (api schedules, worker sends). MESSAGE_PROVIDER picks the SMS/AlimTalk carrier implementation: mock
MESSAGE_PROVIDER=mock
MOCK_RELAY_BASE_URL=http://localhost:4100/relay
# Optional: result webhook URL the api asks the carrier to call (overrides MOCK_RELAY_WEBHOOK_URL below). Leave empty locally.
RELAY_WEBHOOK_URL=
# Per-delivery retries on carrier 429/5xx: attempts and exponential back-off base (ms)
RELAY_SEND_ATTEMPTS=6
RELAY_BACKOFF_MS=1000
# Parallel sends in one worker process
REMINDER_SEND_CONCURRENCY=10
# Accepted-but-no-result deliveries older than this are re-queried from the carrier; how often that job runs (ms)
RELAY_RESULT_TIMEOUT_MS=600000
RELAY_RECONCILE_EVERY_MS=60000

# AI (PLANDIT-20). LLM_PROVIDER picks the LlmClient implementation: mock (no network, no key) | anthropic
LLM_PROVIDER=mock
# Anthropic API key, read only when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Model id. It needs credit rates in packages/shared/src/ai.ts, or the api refuses to start
LLM_MODEL=claude-opus-5-5
# default: a safety-classifier refusal is re-run on Anthropic's fallback model inside the same call (charged at that
# model's rate); off: the refusal comes back as a failed, refunded call
LLM_REFUSAL_FALLBACK=default
# Per-request timeout (ms) and SDK retries (429, 5xx, timeouts)
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=2
# AI usages still RESERVED/CALLING after this long are failed and refunded (ms). Keep it above
# LLM_TIMEOUT_MS × (LLM_MAX_RETRIES + 1). How often the worker checks (ms)
AI_USAGE_STALE_MS=1800000
AI_USAGE_RECONCILE_EVERY_MS=60000
# AI trip itineraries (PLANDIT-26): how many drafts one worker process generates at once
TRIP_PLAN_CONCURRENCY=2

# Mock external servers (apps/mocks): fake PG + fake SMS/AlimTalk carrier. No real payment or message is ever sent.
MOCKS_PORT=4100
# Base URL used in payment page links handed to browsers
MOCKS_PUBLIC_URL=http://localhost:4100
# Where the mock PG posts payment webhooks, and the HMAC-SHA256 secret it signs them with (X-Mock-Signature)
MOCK_PG_WEBHOOK_URL=http://localhost:4000/webhooks/payments/mock
MOCK_PG_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Scenario timings: 02 = confirm response delay, 04 = webhook delay (ms)
MOCK_PG_SLOW_MS=30000
MOCK_PG_WEBHOOK_DELAY_MS=10000
# Where the mock carrier posts delivery results, and its signing secret
MOCK_RELAY_WEBHOOK_URL=http://localhost:4000/webhooks/relay/mock
MOCK_RELAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Carrier behaviour: failure rate (0~1) for valid numbers, result delay (ms), accepted requests per second (over → 429)
RELAY_FAIL_RATE=0.1
RELAY_DELAY_MS=3000
RELAY_RPS=20

# Demo accounts created by pnpm seed:demo (demo@plandit.dev, teammate@plandit.dev). Test value only.
DEMO_PASSWORD=plandit-demo-1234
# Optional: show a "데모 계정으로 둘러보기" button on the login page (public demo only)
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# OAuth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Push notifications
# NOOP records delivery attempts without calling an external service.
PUSH_PROVIDER=NOOP
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Password reset email (optional in development)
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Plandit <noreply@example.com>
