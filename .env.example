# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
API_INTERNAL_URL=http://localhost:4000
API_INTERNAL_SECRET=replace-with-a-long-random-internal-secret
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://plandit:plandit@localhost:5432/plandit
DIRECT_URL=postgresql://plandit:plandit@localhost:5432/plandit

# Redis (BullMQ queues, health check)
REDIS_URL=redis://localhost:6379

# API log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Comma-separated emails of platform operators (can make manual credit adjustments).
# Not the same as workspace OWNER/ADMIN.
PLATFORM_ADMIN_EMAILS=

# Mock external servers (apps/mocks): fake PG + fake SMS/AlimTalk carrier. No real payment or message is ever sent.
MOCKS_PORT=4100
# Base URL used in payment page links handed to browsers
MOCKS_PUBLIC_URL=http://localhost:4100
# Where the mock PG posts payment webhooks, and the HMAC-SHA256 secret it signs them with (X-Mock-Signature)
MOCK_PG_WEBHOOK_URL=http://localhost:4000/webhooks/payments/mock
MOCK_PG_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Scenario timings: 02 = confirm response delay, 04 = webhook delay (ms)
MOCK_PG_SLOW_MS=30000
MOCK_PG_WEBHOOK_DELAY_MS=10000
# Where the mock carrier posts delivery results, and its signing secret
MOCK_RELAY_WEBHOOK_URL=http://localhost:4000/webhooks/relay/mock
MOCK_RELAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Carrier behaviour: failure rate (0~1) for valid numbers, result delay (ms), accepted requests per second (over → 429)
RELAY_FAIL_RATE=0.1
RELAY_DELAY_MS=3000
RELAY_RPS=20

# OAuth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Push notifications
# NOOP records delivery attempts without calling an external service.
PUSH_PROVIDER=NOOP
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Password reset email (optional in development)
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Plandit <noreply@example.com>
