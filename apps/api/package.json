{
  "name": "@plandit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-root-env.mjs ts-node -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "start": "node -r ./register-dist.cjs dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "node ../../scripts/with-root-env.mjs jest -c test/jest-e2e.config.js --runInBand",
    "dev:worker": "node ../../scripts/with-root-env.mjs ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker": "node -r ./register-dist.cjs dist/apps/api/src/worker.js",
    "seed:demo:dist": "node -r ./register-dist.cjs dist/apps/api/src/scripts/seed-demo.js",
    "seed:demo": "node ../../scripts/with-root-env.mjs ts-node -r tsconfig-paths/register src/scripts/seed-demo.ts",
    "check:ledger": "node ../../scripts/with-root-env.mjs ts-node -r tsconfig-paths/register src/scripts/check-ledger.ts",
    "llm:smoke": "node ../../scripts/with-root-env.mjs ts-node -r tsconfig-paths/register src/scripts/llm-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.4.7",
    "@plandit/database": "workspace:*",
    "@plandit/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.9",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.11.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "pg": "8.20.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
